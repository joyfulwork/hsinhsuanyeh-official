# Cloudflare Pages defaults every asset to `max-age=0, must-revalidate` when no
# _headers file exists. That forces a revalidation round trip per asset on every
# visit, and stops the edge holding a durable copy — measured 340-840ms TTFB on a
# cold asset whose body takes 1-8ms to transfer.

# Vite emits content-hashed names here (index-<hash>.js), so a changed build is a
# changed URL and these can never go stale.
/assets/index-*
  Cache-Control: public, max-age=31536000, immutable

# Media keeps its original Wix filenames, so it is not content-hashed. Cache it
# hard but let a replaced file refresh within a day.
/assets/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/videos/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# HTML must stay revalidated so a deploy is visible immediately.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate
